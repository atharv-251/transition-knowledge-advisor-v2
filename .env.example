TRANSITION_PRIMARY_MODEL=gpt-5
TRANSITION_FALLBACK_MODEL=gpt-5-mini
AGENTIC_BLUEPRINT_ENVIRONMENT=development
AGENTIC_BLUEPRINT_WORKFLOW_ID=kt-tracker-bot
AGENTIC_BLUEPRINT_AUDIT_LEVEL=standard
AGENTIC_BLUEPRINT_ENABLE_TRACING=false
KNOWLEDGE_INDEX_PATH=data/index/chunks.jsonl
# Optional Azure AI Search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=transition-knowledge-index
AZURE_SEARCH_KEY=
RETRIEVER_MODE=local

AZURE_SQL_SERVER=sql-transition-knowledge-dev.database.windows.net
AZURE_SQL_DATABASE=transition-knowledge-db
AZURE_SQL_PORT=1433
AZURE_SQL_AUTH_MODE=entra
AZURE_SQL_ENCRYPT=yes
AZURE_SQL_TRUST_SERVER_CERTIFICATE=no
AZURE_SQL_CONNECTION_TIMEOUT=30
AZURE_CLIENT_ID=
AZURE_SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# KT profile extract-and-index endpoint limits
KT_PROFILE_MAX_FILES=10
KT_PROFILE_MAX_TOTAL_BYTES=52428800

# KT Tracker Bot / Microsoft Graph polling
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_SCOPE=https://graph.microsoft.com/.default
GRAPH_TEAM_NAME=
GRAPH_CHANNEL_NAME=

# Required Azure AD app registration permissions (application, admin consent):
#   Calendars.Read, OnlineMeetings.Read.All, OnlineMeetingArtifact.Read.All,
#   OnlineMeetingTranscript.Read.All
# Also requires a Teams application access policy granting this app access to
# the organizer mailbox(es), and transcription enabled in the Teams meeting
# policy for transcripts to exist.
GRAPH_API_BASE_URL=https://graph.microsoft.com/v1.0
GRAPH_REQUEST_TIMEOUT_SECONDS=30
GRAPH_MAX_RETRIES=3

# Automated KT meeting sync (Outlook + Teams -> KT Activities, no manual API calls)
# KT_GRAPH_MODE controls the data source used by the sync pipeline:
#   demo  - use realistic sample meetings/transcripts (no Entra ID/Graph
#           access required); safe for demos while IT access is pending.
#   live  - use real Microsoft Graph via AZURE_TENANT_ID/AZURE_CLIENT_ID/
#           AZURE_CLIENT_SECRET (default).
KT_GRAPH_MODE=live
KT_GRAPH_SYNC_ENABLED=false
KT_GRAPH_SYNC_INTERVAL_SECONDS=900
# Comma-separated mailboxes/UPNs whose calendars should be scanned for KT meetings.
KT_GRAPH_MAILBOXES=
# Comma-separated subject keywords used to identify KT meetings on the calendar.
KT_GRAPH_SUBJECT_KEYWORDS=KT,Knowledge Transfer
KT_GRAPH_LOOKBACK_DAYS=14
KT_GRAPH_LOOKAHEAD_DAYS=30

# KT Scheduler Bot / SMTP calendar invite generation
# Recipients default to the actual attendees from KT_Schedule.csv.
# Set KT_SCHEDULER_TEST_MODE=true only when you explicitly want to redirect
# all invites to KT_SCHEDULER_TEST_RECIPIENTS.
KT_SCHEDULER_DEFAULT_INPUT_PATH=data/kt_scheduler/input/KT_Schedule.csv
KT_SCHEDULER_TIMEZONE=Asia/Kolkata
KT_SCHEDULER_TEST_MODE=false
KT_SCHEDULER_DRY_RUN=false
KT_SCHEDULER_TEST_RECIPIENTS=appsupport@vwgds.in
KT_SCHEDULER_STATE_PATH=data/kt_scheduler/sent_invites.json

KT_SCHEDULER_SMTP_SERVER=mxiblk.relay.vw.vwg
KT_SCHEDULER_SMTP_PORT=25
KT_SCHEDULER_SENDER_EMAIL=vivek.chaurasia@vwgds.in
KT_SCHEDULER_ORGANIZER_NAME=Vivek Chaurasia
KT_SCHEDULER_SMTP_USERNAME=
# Do not commit real credentials. For local testing, set exactly one of:
# KT_SCHEDULER_SMTP_PASSWORD=...
# KT_SCHEDULER_SMTP_PASSWORD_B64=...
# The VW relay (mxiblk.relay.vw.vwg) only advertises SMTP AUTH after
# STARTTLS is negotiated. If KT_SCHEDULER_SMTP_USERNAME/PASSWORD are set,
# also set this to true, or the send fails with
# "SMTP AUTH extension not supported by server."
KT_SCHEDULER_SMTP_STARTTLS=true
KT_SCHEDULER_SMTP_TIMEOUT_SECONDS=30
