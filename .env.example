AZURE_SQL_PORT=1433
AZURE_SQL_AUTH_MODE=entra
AZURE_SQL_ENCRYPT=yes
AZURE_SQL_TRUST_SERVER_CERTIFICATE=no
AZURE_SQL_CONNECTION_TIMEOUT=30
AZURE_CLIENT_ID=
AZURE_SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# KT profile extract-and-index endpoint limits
KT_PROFILE_MAX_FILES=10
KT_PROFILE_MAX_TOTAL_BYTES=52428800

# KT Tracker Bot / Microsoft Graph polling
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_SCOPE=https://graph.microsoft.com/.default
GRAPH_TEAM_NAME=
GRAPH_CHANNEL_NAME=

# Required Azure AD app registration permissions (application, admin consent):
#   Calendars.Read, OnlineMeetings.Read.All, OnlineMeetingArtifact.Read.All,
#   OnlineMeetingTranscript.Read.All
# Also requires a Teams application access policy granting this app access to
# the organizer mailbox(es), and transcription enabled in the Teams meeting
# policy for transcripts to exist.
GRAPH_API_BASE_URL=https://graph.microsoft.com/v1.0
GRAPH_REQUEST_TIMEOUT_SECONDS=30
GRAPH_MAX_RETRIES=3

# Automated KT meeting sync (Outlook + Teams -> KT Activities, no manual API calls)
KT_GRAPH_SYNC_ENABLED=false
KT_GRAPH_SYNC_INTERVAL_SECONDS=900
# Comma-separated mailboxes/UPNs whose calendars should be scanned for KT meetings.
KT_GRAPH_MAILBOXES=
# Comma-separated subject keywords used to identify KT meetings on the calendar.
KT_GRAPH_SUBJECT_KEYWORDS=KT,Knowledge Transfer
KT_GRAPH_LOOKBACK_DAYS=14
KT_GRAPH_LOOKAHEAD_DAYS=30
